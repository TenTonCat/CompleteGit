<UserControl x:Class="CompleteGit.Controls.ConsolePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource ConsoleBgBrush}">
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="BusyText" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ShowQueries" Content="Show background queries" IsChecked="True" Margin="0,0,10,0" ToolTip="Read-only commands the UI runs to refresh itself (status, log, diff…)" Checked="ShowQueries_Click" Unchecked="ShowQueries_Click"/>
                    <Button x:Name="BtnShell" Style="{StaticResource FlatButton}" Click="BtnShell_Click" ToolTip="Shell used for commands you type (click to cycle)"/>
                    <Button x:Name="BtnStop" Content="Stop" Style="{StaticResource FlatButton}" Click="BtnStop_Click" IsEnabled="False" ToolTip="Kill the running command"/>
                    <Button Content="Clear" Style="{StaticResource FlatButton}" Click="BtnClear_Click"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="every command the app runs appears here · type your own below"/>
            </DockPanel>
        </Border>
        <Grid DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PromptText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="Input" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0" Background="Transparent" Padding="2,4"
                     PreviewKeyDown="Input_PreviewKeyDown" ToolTip="Enter runs · Up/Down history · Ctrl+L clears · Esc empties the line"/>
        </Grid>
        <RichTextBox x:Name="Out" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsUndoEnabled="False">
            <FlowDocument x:Name="Doc" PagePadding="8,4"/>
        </RichTextBox>
    </DockPanel>
</UserControl>
