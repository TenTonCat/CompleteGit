<UserControl x:Class="CompleteGit.Controls.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <Grid Background="#B4101014" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border x:Name="Card" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                MinWidth="420" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18,22,18"
                MouseLeftButtonDown="Card_MouseDown" PreviewKeyDown="Card_PreviewKeyDown"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.75"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}" LineHeight="20"/>
                </ScrollViewer>
                <StackPanel x:Name="Fields"/>
                <CheckBox x:Name="Check" Visibility="Collapsed" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="BtnCancel" MinWidth="96" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOk" MinWidth="96" Click="Ok_Click" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
